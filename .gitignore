# Dev dependencies
node_modules/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Windows NUL device artifacts
nul

# IDE
.vscode/
.idea/

# Local config overrides
src/config.local.js

# User-specific BitAxe miner IPs (created by first-launch onboarding)
bitaxe_config.json

# Dev utilities
icons-preview.html
.worktrees/
.superpowers/
.netlify/

# Internal planning / brainstorming notes
docs/superpowers/

# Local pointer to canonical PARA project note (personal absolute path)
.project-note

# Claude Code local config (launch.json is intentionally tracked)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# Secret-file guard (public repo)
.env*
*.pem
*.key

# Timestamped local backups (docker-compose.yml.bak-YYYYMMDD and friends).
# These are made in place before editing deployment config, so they carry
# whatever real LAN addresses the live file had. Untracked and unignored,
# they were one `git add -A` away from being published.
*.bak*
